@model RaceDayMVC.Models.EventResultsViewModel
@{
    ViewData["Title"] = "Record results";
}

<div class="py-4 py-lg-5">
    <a asp-action="Events" class="link-secondary text-decoration-none">&larr; My events</a>
    <div class="mt-3 mb-4">
        <p class="text-uppercase text-primary fw-semibold small mb-2">Organiser workspace</p>
        <h1 class="display-6 fw-bold mb-1">Results</h1>
        <p class="text-muted mb-0">@Model.Event.Name · @Model.Enrolments.Count participant entries</p>
    </div>

    @if (Model.Enrolments.Count == 0)
    {
        <div class="card border-0 bg-light"><div class="card-body p-4 text-center">
            <h2 class="h5">No participants are enrolled yet</h2>
            <p class="text-muted mb-0">Participant entries will appear here after someone enters the event.</p>
        </div></div>
    }
    else
    {
        <div class="row g-3">
        @foreach (var entry in Model.Enrolments)
        {
            var existing = Model.Results.FirstOrDefault(r => r.EnrolmentId == entry.EnrolmentId);
            <div class="col-12">
                <article class="card border-0 shadow-sm">
                    <div class="card-body p-3 p-lg-4">
                        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
                            <div>
                                <h2 class="h5 fw-bold mb-1">@entry.ParticipantName</h2>
                                <p class="text-muted mb-0">@entry.CategoryName · Enrolment: @entry.Status</p>
                            </div>
                            @if (existing is not null)
                            {
                                <span class="badge text-bg-success">Result recorded</span>
                            }
                        </div>

                        @if (existing is not null)
                        {
                            <div class="row g-3 small">
                                <div class="col-sm-3"><span class="text-muted">Status</span><br /><strong>@existing.Status</strong></div>
                                <div class="col-sm-3"><span class="text-muted">Finish time</span><br /><strong>@(existing.FinishTime?.ToString("HH:mm:ss") ?? "—")</strong></div>
                                <div class="col-sm-3"><span class="text-muted">Overall position</span><br /><strong>@(existing.OverallPosition?.ToString() ?? "—")</strong></div>
                                <div class="col-sm-3"><span class="text-muted">Category position</span><br /><strong>@(existing.CategoryPosition?.ToString() ?? "—")</strong></div>
                            </div>
                        }
                        else if (entry.Status == "Cancelled")
                        {
                            <p class="text-muted mb-0">A cancelled entry cannot receive a result.</p>
                        }
                        else
                        {
                            <form asp-action="RecordResult" asp-route-eventId="@Model.Event.EventId" asp-route-enrolmentId="@entry.EnrolmentId" method="post">
                                <div class="row g-3 align-items-end">
                                    <div class="col-6 col-md-2">
                                        <label class="form-label" for="status-@entry.EnrolmentId">Result status</label>
                                        <select class="form-select" id="status-@entry.EnrolmentId" name="Status">
                                            <option value="Finished">Finished</option>
                                            <option value="DNF">DNF</option>
                                            <option value="DNS">DNS</option>
                                            <option value="DSQ">DSQ</option>
                                        </select>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label" for="time-@entry.EnrolmentId">Finish time</label>
                                        <input class="form-control" id="time-@entry.EnrolmentId" name="FinishTime" type="time" step="1" />
                                    </div>
                                    <div class="col-6 col-md-2">
                                        <label class="form-label" for="overall-@entry.EnrolmentId">Overall place</label>
                                        <input class="form-control" id="overall-@entry.EnrolmentId" name="OverallPosition" type="number" min="1" />
                                    </div>
                                    <div class="col-6 col-md-2">
                                        <label class="form-label" for="category-@entry.EnrolmentId">Category place</label>
                                        <input class="form-control" id="category-@entry.EnrolmentId" name="CategoryPosition" type="number" min="1" />
                                    </div>
                                    <div class="col-12 col-md-3 d-grid">
                                        <button class="btn btn-primary" type="submit">Save result</button>
                                    </div>
                                </div>
                            </form>
                        }
                    </div>
                </article>
            </div>
        }
        </div>
    }
</div>
