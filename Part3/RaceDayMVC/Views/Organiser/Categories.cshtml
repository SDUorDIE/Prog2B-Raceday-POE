@model RaceDayMVC.Models.CategoryManagementViewModel
@{
    ViewData["Title"] = "Event categories";
}

<div class="row justify-content-center py-4 py-lg-5">
    <div class="col-12 col-xl-10">
        <a asp-action="Events" class="link-secondary text-decoration-none">&larr; My events</a>
        <div class="mt-3 mb-4">
            <p class="text-uppercase text-primary fw-semibold small mb-2">Organiser workspace</p>
            <h1 class="display-6 fw-bold mb-1">Categories</h1>
            <p class="text-muted mb-0">@Model.Event.Name · @Model.Event.EventDate.ToString("ddd, dd MMM yyyy")</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h4 mb-3">Current categories</h2>
                        @if (Model.Event.Categories.Count == 0)
                        {
                            <p class="text-muted mb-0">There are no categories for this event yet.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead><tr><th>Name</th><th>Distance</th><th>Entry fee</th><th>Capacity</th><th>Ages</th><th>Status</th></tr></thead>
                                    <tbody>
                                    @foreach (var category in Model.Event.Categories)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@category.Name</td>
                                            <td>@category.DistanceKm.ToString("0.##") km</td>
                                            <td>R @category.EntryFee.ToString("0.00")</td>
                                            <td>@category.Capacity</td>
                                            <td>@(category.MinimumAge?.ToString() ?? "—")–@(category.MaximumAge?.ToString() ?? "—")</td>
                                            <td><span class="badge @(category.IsActive ? "text-bg-success" : "text-bg-secondary")">@(category.IsActive ? "Active" : "Inactive")</span></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h4 mb-3">Add a category</h2>
                        <form asp-action="CreateCategory" asp-route-eventId="@Model.Event.EventId" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                            <div class="mb-3">
                                <label asp-for="Form.Name" class="form-label">Category name</label>
                                <input asp-for="Form.Name" class="form-control" placeholder="For example, 5 km Open" />
                                <span asp-validation-for="Form.Name" class="text-danger small"></span>
                            </div>
                            <div class="row g-3">
                                <div class="col-6">
                                    <label asp-for="Form.DistanceKm" class="form-label">Distance (km)</label>
                                    <input asp-for="Form.DistanceKm" type="number" min="0.01" max="1000" step="0.01" class="form-control" />
                                    <span asp-validation-for="Form.DistanceKm" class="text-danger small"></span>
                                </div>
                                <div class="col-6">
                                    <label asp-for="Form.EntryFee" class="form-label">Entry fee (R)</label>
                                    <input asp-for="Form.EntryFee" type="number" min="0" step="0.01" class="form-control" />
                                    <span asp-validation-for="Form.EntryFee" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Form.Capacity" class="form-label">Capacity</label>
                                    <input asp-for="Form.Capacity" type="number" min="1" class="form-control" />
                                    <span asp-validation-for="Form.Capacity" class="text-danger small"></span>
                                </div>
                                <div class="col-6">
                                    <label asp-for="Form.MinimumAge" class="form-label">Minimum age <span class="text-muted">(optional)</span></label>
                                    <input asp-for="Form.MinimumAge" type="number" min="0" max="120" class="form-control" />
                                    <span asp-validation-for="Form.MinimumAge" class="text-danger small"></span>
                                </div>
                                <div class="col-6">
                                    <label asp-for="Form.MaximumAge" class="form-label">Maximum age <span class="text-muted">(optional)</span></label>
                                    <input asp-for="Form.MaximumAge" type="number" min="0" max="120" class="form-control" />
                                    <span asp-validation-for="Form.MaximumAge" class="text-danger small"></span>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 mt-4">Add category</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
