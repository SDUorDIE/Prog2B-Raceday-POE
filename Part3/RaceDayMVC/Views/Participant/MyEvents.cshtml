@model List<RaceDayMVC.Models.EnrolmentSummary>
@{
    ViewData["Title"] = "My events";
}

<div class="py-4 py-lg-5">
    <p class="text-uppercase text-primary fw-semibold small mb-2">Participant workspace</p>
    <h1 class="display-6 fw-bold mb-1">My events</h1>
    <p class="text-muted mb-4">Your event entries and their current status.</p>

    @if (Model.Count == 0)
    {
        <div class="card border-0 bg-light">
            <div class="card-body p-4 p-lg-5 text-center">
                <h2 class="h4">You haven’t entered an event yet</h2>
                <p class="text-muted">Browse the upcoming events and choose a category to get started.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse events</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var entry in Model.OrderByDescending(e => e.EnrolmentDate))
            {
                var statusClass = entry.Status == "Confirmed" ? "text-bg-success" : entry.Status == "Pending" ? "text-bg-warning" : "text-bg-secondary";
                <div class="col-12">
                    <article class="card border-0 shadow-sm">
                        <div class="card-body p-3 p-lg-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div>
                                <h2 class="h5 fw-bold mb-1">@entry.EventName</h2>
                                <p class="text-muted mb-0">@entry.CategoryName · Entered @entry.EnrolmentDate.ToLocalTime().ToString("dd MMM yyyy")</p>
                            </div>
                            <span class="badge rounded-pill @statusClass px-3 py-2">@entry.Status</span>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
