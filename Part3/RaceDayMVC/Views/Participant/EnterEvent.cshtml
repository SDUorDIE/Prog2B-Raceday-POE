@model RaceDayMVC.Models.EnterEventViewModel
@{
    ViewData["Title"] = "Enter event";
}

<div class="row justify-content-center py-4 py-lg-5">
    <div class="col-12 col-xl-8">
        <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Event.EventId" class="link-secondary text-decoration-none">&larr; Event details</a>
        <div class="mt-3 mb-4">
            <p class="text-uppercase text-primary fw-semibold small mb-2">Participant entry</p>
            <h1 class="display-6 fw-bold">Enter @Model.Event.Name</h1>
            <p class="text-muted mb-0">Choose a category and add an emergency contact.</p>
        </div>

        @if (Model.Event.Categories.Count == 0)
        {
            <div class="alert alert-info" role="status">This event has no active categories available for entry yet.</div>
        }
        else
        {
            <form asp-action="EnterEvent" asp-route-eventId="@Model.Event.EventId" method="post" class="card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-4">
                        <label asp-for="Form.CategoryId" class="form-label">Race category</label>
                        <select asp-for="Form.CategoryId" class="form-select">
                            <option value="0">Choose a category</option>
                            @foreach (var category in Model.Event.Categories)
                            {
                                <option value="@category.CategoryId">@category.Name · @category.DistanceKm.ToString("0.##") km · R @category.EntryFee.ToString("0.00")</option>
                            }
                        </select>
                        <span asp-validation-for="Form.CategoryId" class="text-danger small"></span>
                    </div>
                    <h2 class="h5 mb-3">Emergency contact</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Form.EmergencyContactName" class="form-label">Contact name</label>
                            <input asp-for="Form.EmergencyContactName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="Form.EmergencyContactName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Form.EmergencyContactPhone" class="form-label">Contact phone</label>
                            <input asp-for="Form.EmergencyContactPhone" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="Form.EmergencyContactPhone" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 px-4 px-lg-5 pb-4 d-flex justify-content-end gap-2">
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Event.EventId" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Confirm entry</button>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
