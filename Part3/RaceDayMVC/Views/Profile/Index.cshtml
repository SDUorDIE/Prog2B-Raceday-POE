@model RaceDayMVC.Models.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="py-4 py-lg-5">
    <p class="text-uppercase text-primary fw-semibold small mb-2">Account</p>
    <h1 class="display-6 fw-bold mb-1">Your profile</h1>
    <p class="text-muted mb-4">Review and update the details linked to your RaceDay account.</p>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                    {
                        <img class="profile-avatar mb-3" src="@Model.ProfilePictureUrl" alt="Profile picture for @Model.FirstName @Model.LastName" />
                    }
                    else
                    {
                        <div class="profile-avatar mb-3" aria-hidden="true">@Model.FirstName.FirstOrDefault()@Model.LastName.FirstOrDefault()</div>
                    }
                    <h2 class="h4">@Model.FirstName @Model.LastName</h2>
                    <p class="text-muted mb-1">@Model.Email</p>
                    <span class="badge text-bg-secondary">@Model.Role</span>
                    <hr />
                    <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="mt-3">
                        <label for="file" class="form-label">Profile picture</label>
                        <input id="file" name="file" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
                        <div class="form-text">JPG, PNG or WebP; maximum 5 MB.</div>
                        <button class="btn btn-outline-primary btn-sm mt-2" type="submit">Upload picture</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Index" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="Email" type="hidden" id="email-hidden" />
                        <input asp-for="Role" type="hidden" />
                        <input asp-for="ProfilePictureUrl" type="hidden" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Email" class="form-label"></label>
                                <input id="Email" value="@Model.Email" class="form-control" disabled />
                            </div>
                            <div class="col-12">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-4">Save profile</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
