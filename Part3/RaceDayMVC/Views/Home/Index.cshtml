@model RaceDayMVC.Models.EventsIndexViewModel
@inject RaceDayMVC.Services.RaceDayApiClient Api
@{
    ViewData["Title"] = "Find an event";
}

<section class="py-5">
    <div class="row align-items-end g-4 mb-4">
        <div class="col-lg-7">
            <p class="text-uppercase text-primary fw-semibold small mb-2">Find your next starting line</p>
            <h1 class="display-5 fw-bold mb-2">RaceDay events</h1>
            <p class="lead text-muted mb-0">Discover a race, ride or walk and make your next day count.</p>
        </div>
        <div class="col-lg-5 text-lg-end">
            <span class="badge rounded-pill text-bg-light border px-3 py-2">Upcoming events</span>
        </div>
    </div>

    <form method="get" asp-action="Index" class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 p-lg-4">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <label for="search" class="form-label">Search events</label>
                    <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event, venue or city" />
                </div>
                <div class="col-12 col-sm-4 col-lg-2">
                    <label for="eventType" class="form-label">Activity</label>
                    <select id="eventType" name="eventType" class="form-select">
                        <option value="">All types</option>
                        <option value="Running" selected="@(Model.EventType == "Running")">Running</option>
                        <option value="Walking" selected="@(Model.EventType == "Walking")">Walking</option>
                        <option value="Cycling" selected="@(Model.EventType == "Cycling")">Cycling</option>
                    </select>
                </div>
                <div class="col-6 col-sm-4 col-lg-2">
                    <label for="from" class="form-label">From</label>
                    <input id="from" name="from" type="date" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-6 col-sm-4 col-lg-2">
                    <label for="to" class="form-label">To</label>
                    <input id="to" name="to" type="date" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-12 col-lg-2 d-grid">
                    <button type="submit" class="btn btn-primary">Find events</button>
                </div>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
    }
    else if (Model.Events.Count == 0)
    {
        <div class="card border-0 bg-light">
            <div class="card-body p-4 p-lg-5 text-center">
                <h2 class="h4">No events match those filters</h2>
                <p class="text-muted mb-3">Try a different activity or date range, or clear your search.</p>
                <a asp-action="Index" class="btn btn-outline-primary">Show upcoming events</a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">@Model.Events.Count event@(Model.Events.Count == 1 ? "" : "s")</h2>
        </div>
        <div class="row g-4">
            @foreach (var item in Model.Events)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <article class="card h-100 border-0 shadow-sm event-card">
                        @if (!string.IsNullOrWhiteSpace(item.BannerImageUrl))
                        {
                            <img src="@Api.AbsoluteApiUrl(item.BannerImageUrl)" class="event-card-banner" alt="Banner for @item.Name" />
                        }
                        <div class="event-card-accent"></div>
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <span class="badge rounded-pill text-bg-primary-subtle text-primary-emphasis">@item.EventType</span>
                                <span class="small text-muted">@item.DistanceKm.ToString("0.##") km</span>
                            </div>
                            <h3 class="h5 fw-bold">@item.Name</h3>
                            <p class="text-muted">@item.Description</p>
                            <dl class="row small mb-4 mt-auto">
                                <dt class="col-4 text-muted">Date</dt>
                                <dd class="col-8">@item.EventDate.ToString("ddd, dd MMM yyyy") · @item.StartTime.ToString("HH:mm")</dd>
                                <dt class="col-4 text-muted">Location</dt>
                                <dd class="col-8">@item.Venue, @item.City</dd>
                            </dl>
                            <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-outline-primary">View event</a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
